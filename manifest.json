{
	"name": "Markback – Timestamp Bookmarks for YouTube™",
	"version": "1.0.0",
	"description": "Bookmark moments in YouTube videos and Shorts, add notes, and jump back to them in one click.",
	"permissions": ["storage"],
	"host_permissions": ["https://*.youtube.com/*"],
	"background": {
		"service_worker": "js/background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://*.youtube.com/*"],
			"js": ["js/utils.js", "js/contentScript.js"],
			"css": ["css/contentScript.css"]
		}
	],
	"icons": {
		"16": "assets/icon-16.png",
		"32": "assets/icon-32.png",
		"48": "assets/icon-48.png",
		"128": "assets/icon-128.png"
	},
	"action": {
		"default_icon": {
			"16": "assets/icon-16.png",
			"32": "assets/icon-32.png",
			"48": "assets/icon-48.png",
			"128": "assets/icon-128.png"
		},
		"default_title": "Markback",
		"default_popup": "popup.html"
	},
	"manifest_version": 3
}
